      "transform": [
        {
          "type": "geopoint",
          "projection": "geo",
          "fields": [
            "lon",
            "lat"
          ]
        },
        {
          "type": "formula",
          "expr": "mapW < 380 ? 28 : datum.full_label_width",
          "as": "label_width"
        },
        {
          "type": "formula",
          "expr": "datum.side == 'left' ? 8 : mapW-datum.label_width-8",
          "as": "lx"
        },
        {
          "type": "formula",
          "expr": "datum.slot*mapH",
          "as": "ly"
        },
        {
          "type": "formula",
          "expr": "datum.side == 'left' ? datum.lx+datum.label_width : datum.lx",
          "as": "leader_x"
        },
        {
          "type": "formula",
          "expr": "sqrt(pow(datum.x-data('origin')[0].x,2)+pow(datum.y-data('origin')[0].y,2))",
          "as": "radius"
        },
        {
          "type": "formula",
          "expr": "'M'+data('origin')[0].x+','+data('origin')[0].y+' C'+(data('origin')[0].x+datum.radius*datum.c1x)+','+(data('origin')[0].y+datum.radius*datum.c1y)+' '+(data('origin')[0].x+datum.radius*datum.c2x)+','+(data('origin')[0].y+datum.radius*datum.c2y)+' '+(data('origin')[0].x+datum.radius*datum.midx)+','+(data('origin')[0].y+datum.radius*datum.midy)+' C'+(data('origin')[0].x+datum.radius*datum.c3x)+','+(data('origin')[0].y+datum.radius*datum.c3y)+' '+(data('origin')[0].x+datum.radius*datum.c4x)+','+(data('origin')[0].y+datum.radius*datum.c4y)+' '+datum.x+','+datum.y",
          "as": "path"
        }
      ]
    },
    {
      "name": "world",
      "url": "data/world-110m.json",
      "format": {
        "type": "topojson",
        "feature": "countries"
      },
      "transform": [
        {
          "type": "formula",
          "expr": "+datum.id",
          "as": "geo_id"
        },
        {
          "type": "lookup",
          "from": "points",
          "key": "geo_id",
          "fields": [
            "geo_id"
          ],
          "values": [
            "country"
          ],
          "as": [
            "country"
          ]
        }
      ]
    },
    {
      "name": "routes",
      "source": "points",
      "transform": [
        {
          "type": "formula",
          "expr": "datum.country == activeMarket ? 100 : datum.rank",
          "as": "drawOrder"
        },
        {
          "type": "collect",
          "sort": {
            "field": "drawOrder"
          }
        }
      ]
    },
    {
      "name": "summary",
      "source": "points",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.country == activeMarket"
        }
      ]
    },
    {
      "name": "key",
      "values": [
        {
          "t": 25000,
          "i": 0
        },
        {
          "t": 75000,
          "i": 1
        },
        {
          "t": 150000,
          "i": 2
        }
      ]
    }
  ],
  "projections": [
    {
      "name": "geo",
      "type": "mercator",
      "fit": {
        "signal": "data('frame')"
      },
      "size": {
        "signal": "[mapW,mapH]"
      },
      "clipExtent": {
        "signal": "[[0,0],[mapW,mapH]]"
      }
    }
  ],
  "scales": [
    {
      "name": "weight",
      "type": "linear",
      "domain": [
        0,
        160000
      ],
      "range": [
        0,
        6
      ],
      "zero": true
    }
  ],
  "marks": [
    {
      "type": "rect",
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 0
          },
          "width": {
            "signal": "width"
          },
          "height": {
            "value": 56
          },
          "fill": {
            "value": "#edf5fa"
          },
          "cornerRadius": {
            "value": 5
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "summary"
      },
      "encode": {
        "update": {
          "x": {
            "value": 12
          },
          "y": {
            "value": 23
          },
          "text": {
            "signal": "datum.display+(marketHover && marketHover != destination ? ' · preview' : '')"
          },
          "fontSize": {
            "value": 17
          },
          "fontWeight": {
            "value": "bold"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "summary"
      },
      "encode": {
        "update": {
          "x": {
            "value": 12
          },
          "y": {
            "value": 44
          },
          "text": {
            "signal": "format(datum.tonnes,',.0f')+' tonnes · AUD '+format(datum.value_aud_m,',.0f')+' million'"
          },
          "fontSize": {
            "value": 12
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 12
          },
          "y": {
            "value": 23
          },
          "text": {
            "value": "Ten leading markets · 2024–25"
          },
          "fontSize": {
            "value": 17
          },
          "fontWeight": {
            "value": "bold"
          },
          "opacity": {
            "signal": "activeMarket == 'All' ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 12
          },
          "y": {
            "value": 44
          },
          "text": {
            "signal": "mapW < 380 ? 'Numbers match the market list below.' : 'All ten connections visible · select to highlight'"
          },
          "fontSize": {
            "value": 12
          },
          "opacity": {
            "signal": "activeMarket == 'All' ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "group",
      "clip": true,
      "encode": {
        "update": {
          "y": {
            "signal": "mapTop"
          },
          "width": {
            "signal": "mapW"
          },
          "height": {
            "signal": "mapH"
          }
        }
      },
      "marks": [
        {
          "type": "shape",
          "from": {
            "data": "world"
          },
          "transform": [
            {
              "type": "geoshape",
              "projection": "geo"
            }
          ],
          "encode": {
            "update": {
              "fill": {
                "signal": "datum.geo_id == 36 ? '#dcebe3' : datum.country == activeMarket ? '#b9d8ed' : '#edf2f5'"
              },
              "stroke": {
                "value": "white"
              },
              "strokeWidth": {
                "value": 0.7
              }
            }
          }
        },
        {
          "type": "path",
          "name": "exportHalo",
          "from": {
            "data": "routes"
          },
          "encode": {
            "update": {
              "path": {
                "field": "path"
              },
              "fill": {
                "value": null
              },
              "stroke": {
                "value": "white"
