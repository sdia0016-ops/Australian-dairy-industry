{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Export flow map with all ten connections always visible. Non-crossing radial curves fan from a shared Australian origin to representative geographic endpoints. Separated country callouts and a clickable ranked list identify the dense Asian markets. Selecting or hovering highlights a route without hiding others. Width maps tonnes on a fixed zero-based scale. Curves are schematic, not shipping routes. Greater China is a published aggregate.",
  "width": 1000,
  "height": 580,
  "padding": 14,
  "background": "white",
  "autosize": {
    "type": "none",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "text": {
      "font": "Avenir Next, Arial, sans-serif",
      "fill": "#173d65"
    },
    "axis": {
      "labelFont": "Avenir Next, Arial, sans-serif",
      "labelFontSize": 13,
      "labelColor": "#42566b",
      "domainColor": "#a3b5c3",
      "tickColor": "#a3b5c3",
      "titleFontSize": 13
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "signals": [
    {
      "name": "destination",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "Greater China",
          "Japan",
          "Malaysia",
          "Singapore",
          "Indonesia",
          "Thailand",
          "Vietnam",
          "Philippines",
          "Korea, South",
          "New Zealand"
        ],
        "labels": [
          "All ten markets",
          "Greater China",
          "Japan",
          "Malaysia",
          "Singapore",
          "Indonesia",
          "Thailand",
          "Vietnam",
          "Philippines",
          "South Korea",
          "New Zealand"
        ],
        "name": "Highlight market "
      },
      "on": [
        {
          "events": "@marketHit:click, @countryLabelHit:click, @countryPoint:click",
          "update": "datum.country"
        }
      ]
    },
    {
      "name": "marketHover",
      "value": "",
      "on": [
        {
          "events": {
            "signal": "destination"
          },
          "update": "''"
        },
        {
          "events": "@marketHit:mouseover, @countryLabelHit:mouseover, @countryPoint:mouseover",
          "update": "datum.country"
        },
        {
          "events": "@marketHit:mouseout, @countryLabelHit:mouseout, @countryPoint:mouseout",
          "update": "''"
        }
      ]
    },
    {
      "name": "activeMarket",
      "update": "marketHover || destination"
    },
    {
      "name": "wide",
      "update": "width >= 720"
    },
    {
      "name": "mapW",
      "update": "wide ? width*.64 : width"
    },
    {
      "name": "mapH",
      "update": "wide ? 440 : 430"
    },
    {
      "name": "mapTop",
      "value": 66
    },
    {
      "name": "tableX",
      "update": "wide ? mapW+25 : 8"
    },
    {
      "name": "tableY",
      "update": "wide ? 86 : mapTop+mapH+74"
    },
    {
      "name": "tableW",
      "update": "wide ? width-mapW-32 : width-16"
    },
    {
      "name": "rowH",
      "update": "wide ? 39 : 33"
    }
  ],
  "data": [
    {
      "name": "frame",
      "values": [
        {
          "type": "Feature",
