  "params": [
    {
      "name": "slopeState",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "NSW",
          "VIC",
          "QLD",
          "SA",
          "WA",
          "TAS"
        ],
        "name": "Highlight state "
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "period",
      "type": "ordinal",
      "sort": [
        "2011–12",
        "2024–25"
      ],
      "title": null,
      "scale": {
        "padding": 0.7
      },
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12
      }
    },
    "y": {
      "field": "cows_per_farm",
      "type": "quantitative",
      "title": "Approx. cows per registered farm",
      "scale": {
        "domain": [
          150,
          550
        ],
        "zero": false
      },
      "axis": {
        "tickCount": 5
      }
    },
    "color": {
      "field": "state_code",
      "type": "nominal",
      "scale": {
        "domain": [
          "NSW",
          "VIC",
          "QLD",
          "SA",
          "WA",
          "TAS"
        ],
        "range": [
          "#286a9e",
          "#367d60",
          "#bd802d",
          "#846289",
          "#568c9b",
          "#77654d"
        ]
      },
      "legend": null
    },
    "opacity": {
      "condition": {
        "test": "slopeState == 'All' || datum.state_code == slopeState",
        "value": 1
      },
      "value": 0.12
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "period",
        "type": "nominal",
        "title": "Financial year"
      },
      {
        "field": "farms",
        "type": "quantitative",
        "title": "Registered farms",
        "format": ",.0f"
      },
      {
        "field": "cows_thousand",
        "type": "quantitative",
        "title": "Cows (rounded thousands)",
        "format": ",.0f"
      },
      {
        "field": "cows_per_farm",
        "type": "quantitative",
        "title": "Approx. cows per farm",
        "format": ".1f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "point": {
          "filled": true,
          "size": 65
        }
      },
      "encoding": {
        "detail": {
          "field": "state_code"
        },
        "order": {
          "field": "year_end"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year_end == 2012"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 10,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year_end == 2025"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 10,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "usermeta": {
    "author": "Senuth Dias; AI-assisted implementation, acknowledged on page",
    "prepared": "2026-10-14"
  }
