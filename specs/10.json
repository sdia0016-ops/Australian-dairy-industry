    {
      "name": "before",
      "source": "all",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.year_end == 2019"
        }
      ]
    },
    {
      "name": "after",
      "source": "all",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.year_end == demandYear"
        }
      ]
    },
    {
      "name": "ticks",
      "values": [
        {
          "g": 0
        },
        {
          "g": 50
        },
        {
          "g": 100
        },
        {
          "g": 150
        },
        {
          "g": 200
        }
      ],
      "transform": [
        {
          "type": "filter",
          "expr": "width >= 600 || datum.g % 100 == 0"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "left",
      "type": "linear",
      "domain": [
        0,
        220
      ],
      "range": [
        {
          "signal": "wingW"
        },
        0
      ],
      "zero": true
    },
    {
      "name": "right",
      "type": "linear",
      "domain": [
        0,
        220
      ],
      "range": [
        {
          "signal": "wingW+centerW"
        },
        {
          "signal": "width"
        }
      ],
      "zero": true
    },
    {
      "name": "row",
      "type": "band",
      "domain": [
        "Dairy milk",
        "Yoghurt",
        "Cheese",
        "Unflavoured milk alternatives"
      ],
      "range": [
        42,
        260
      ],
      "paddingInner": 0.5,
      "paddingOuter": 0.2
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "before"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "left",
            "field": "grams_per_person_day"
          },
          "x2": {
            "signal": "wingW"
          },
          "y": {
            "scale": "row",
            "field": "product"
          },
          "height": {
            "signal": "bandwidth('row')"
          },
          "fill": {
            "value": "#286a9e"
          },
          "tooltip": {
            "signal": "{'Product':datum.product,'Year':datum.fy,'Grams per person per day':format(datum.grams_per_person_day,'.1f'),'Change since 2018–19 (%)':format(datum.change_pct,'+.1f')}"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "after"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "wingW+centerW"
          },
          "x2": {
            "scale": "right",
            "field": "grams_per_person_day"
          },
          "y": {
            "scale": "row",
            "field": "product"
          },
          "height": {
            "signal": "bandwidth('row')"
          },
          "fill": {
            "value": "#367d60"
          },
          "tooltip": {
            "signal": "{'Product':datum.product,'Year':datum.fy,'Grams per person per day':format(datum.grams_per_person_day,'.1f'),'Change since 2018–19 (%)':format(datum.change_pct,'+.1f')}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "before"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "width/2"
          },
          "y": {
            "scale": "row",
            "field": "product",
            "band": 0.5
          },
          "text": {
            "signal": "datum.product == 'Unflavoured milk alternatives' ? 'Milk\\nalternatives*' : datum.product"
          },
          "lineBreak": {
            "value": "\n"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "signal": "width < 600 ? 11 : 13"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "before"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "scale('left',datum.grams_per_person_day)+(datum.grams_per_person_day>50 ? 5 : -5)"
          },
          "y": {
            "scale": "row",
            "field": "product",
            "band": 0.5
          },
          "text": {
            "signal": "format(datum.grams_per_person_day,'.1f')"
          },
          "align": {
            "signal": "datum.grams_per_person_day>50 ? 'left' : 'right'"
          },
          "fill": {
            "signal": "datum.grams_per_person_day>50 ? 'white' : '#173d65'"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 11
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "after"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "scale('right',datum.grams_per_person_day)+(datum.grams_per_person_day>50 ? -5 : 5)"
          },
          "y": {
            "scale": "row",
            "field": "product",
            "band": 0.5
          },
          "text": {
            "signal": "format(datum.grams_per_person_day,'.1f')"
          },
          "align": {
            "signal": "datum.grams_per_person_day>50 ? 'right' : 'left'"
          },
          "fill": {
            "signal": "datum.grams_per_person_day>50 ? 'white' : '#173d65'"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 11
          }
        }
      }
    },
