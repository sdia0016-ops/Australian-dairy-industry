{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Butterfly chart comparing ABS retail purchases per person per day in 2018–19 with a selected later year. Both wings have positive magnitudes, mirrored zero baselines and the same 0–220 g/person/day scale. ABS estimates are purchases, not diet; nondairy alternatives are separate.",
  "width": 1000,
  "height": 305,
  "padding": 14,
  "background": "white",
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "text": {
      "font": "Avenir Next, Arial, sans-serif",
      "fill": "#173d65"
    },
    "axis": {
      "labelFont": "Avenir Next, Arial, sans-serif",
      "labelFontSize": 11,
      "labelColor": "#42566b",
      "domainColor": "#a3b5c3",
      "tickColor": "#a3b5c3"
    }
  },
  "signals": [
    {
      "name": "demandYear",
      "value": 2024,
      "bind": {
        "input": "select",
        "options": [
          2020,
          2021,
          2022,
          2023,
          2024
        ],
        "labels": [
          "2019–20",
          "2020–21",
          "2021–22",
          "2022–23",
          "2023–24"
        ],
        "name": "Compare 2018–19 with "
      }
    },
    {
      "name": "centerW",
      "update": "width < 600 ? 108 : 180"
    },
    {
      "name": "wingW",
      "update": "(width-centerW)/2"
    },
    {
      "name": "endLabel",
      "update": "(demandYear-1)+'–'+substring(''+demandYear,2,4)"
    }
  ],
