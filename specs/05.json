{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Waterfall decomposition of the national milk-production change between 2024–25 and 2025–26. State changes sum to the final national bar.",
  "width": 500,
  "height": 350,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": 12,
  "config": {
    "font": "Avenir Next, Arial, sans-serif",
    "background": "white",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelColor": "#42566b",
      "titleColor": "#42566b",
      "gridColor": "#e5edf2",
      "domainColor": "#a3b5c3",
      "tickColor": "#a3b5c3",
      "titlePadding": 12,
      "labelPadding": 6
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#42566b",
      "titleColor": "#42566b",
      "orient": "bottom"
    },
    "range": {
      "category": [
        "#286a9e",
        "#367d60",
        "#bd802d",
        "#846289",
        "#568c9b",
        "#77654d"
      ]
    }
  },
  "data": {
    "values": [
