        "kind": "Increase",
        "order": 1,
        "label_y": 127.40474706787381
      },
      {
        "state": "TAS",
        "next_state": "QLD",
        "delta": 23.530429042172045,
        "start": 127.40474706787381,
        "end": 150.93517611004586,
        "kind": "Increase",
        "order": 2,
        "label_y": 150.93517611004586
      },
      {
        "state": "QLD",
        "next_state": "WA",
        "delta": 9.063658048978539,
        "start": 150.93517611004586,
        "end": 159.9988341590244,
        "kind": "Increase",
        "order": 3,
        "label_y": 159.9988341590244
      },
      {
        "state": "WA",
        "next_state": "SA",
        "delta": -2.5674869734513095,
        "start": 159.9988341590244,
        "end": 157.4313471855731,
        "kind": "Decrease",
        "order": 4,
        "label_y": 159.9988341590244
      },
      {
        "state": "SA",
        "next_state": "AUS",
        "delta": -28.367409674577914,
        "start": 157.4313471855731,
        "end": 129.06393751099517,
        "kind": "Decrease",
        "order": 5,
        "label_y": 157.4313471855731
      },
      {
        "state": "AUS",
        "delta": 129.06393751099517,
        "start": 0,
        "end": 129.06393751099517,
        "kind": "Net change",
        "order": 6,
        "label_y": 129.06393751099517
      }
    ]
  },
  "encoding": {
    "x": {
      "field": "state",
      "type": "ordinal",
      "sort": [
        "VIC",
        "NSW",
        "TAS",
        "QLD",
        "WA",
        "SA",
        "AUS"
      ],
      "title": null,
      "scale": {
        "paddingInner": 0.35,
        "paddingOuter": 0.2
      },
      "axis": {
        "labelAngle": 0,
        "labelExpr": "datum.label == 'AUS' ? ['Net','AUS'] : datum.label"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#42566b"
      },
      "encoding": {
        "y": {
          "datum": 0
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state != 'AUS'"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#9aadb9",
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x2": {
          "field": "next_state"
        },
        "y": {
          "field": "end",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "bar"
      },
      "encoding": {
        "y": {
          "field": "start",
          "type": "quantitative",
          "title": "Change in million litres"
        },
        "y2": {
          "field": "end"
        },
        "color": {
          "field": "kind",
          "type": "nominal",
          "scale": {
            "domain": [
              "Increase",
              "Decrease",
              "Net change"
            ],
            "range": [
              "#367d60",
              "#bd802d",
              "#286a9e"
            ]
          },
          "legend": {
            "title": null,
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "delta",
            "type": "quantitative",
            "title": "Contribution (million litres)",
            "format": "+.1f"
          },
          {
            "field": "start",
            "type": "quantitative",
            "title": "Running total before (ML)",
            "format": "+.1f"
          },
          {
            "field": "end",
            "type": "quantitative",
            "title": "Running total after (ML)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "format(datum.delta,width < 450 ? '+.0f' : '+.1f')",
          "as": "display_delta"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -10,
        "fontSize": 12,
        "color": "#173d65",
        "fontWeight": {
          "expr": "datum.state == 'AUS' ? 'bold' : 'normal'"
        }
      },
      "encoding": {
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "display_delta",
          "type": "nominal"
        }
      }
    }
  ],
  "usermeta": {
    "author": "Senuth Dias; AI-assisted implementation, acknowledged on page",
    "prepared": "2026-10-22"
  }
}
