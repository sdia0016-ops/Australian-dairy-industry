{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Connected endpoints compare registered farms in 2011–12 and provisional 2024–25. Default positions index each state’s earlier count to 100; labels retain actual farms. A native mode switches to a common zero-based count scale. Relative counts are not a cohort of surviving farms.",
  "width": 1000,
  "height": 440,
  "padding": 14,
  "background": "white",
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "text": {
      "font": "Avenir Next, Arial, sans-serif",
      "fill": "#173d65"
    },
    "axis": {
      "labelFont": "Avenir Next, Arial, sans-serif",
      "labelFontSize": 13,
      "labelColor": "#42566b",
      "domainColor": "#a3b5c3",
      "tickColor": "#a3b5c3",
      "titleFontSize": 13
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  },
  "signals": [
    {
      "name": "farmMeasure",
      "value": "Relative to 2011–12",
      "bind": {
        "input": "select",
        "name": "Compare ",
        "options": [
          "Relative to 2011–12",
          "Actual counts"
        ]
      }
    },
    {
      "name": "indexed",
      "update": "farmMeasure == 'Relative to 2011–12'"
    }
  ],
  "data": [
    {
      "name": "pairs",
      "values": [
        {
          "state": "NSW",
          "old": 778.0,
          "new": 443.0,
          "ratio_pct": 56.940874035989715,
          "change_pct": -43.05912596401028
        },
        {
          "state": "VIC",
          "old": 4556.0,
          "new": 2476.0,
          "ratio_pct": 54.3459174714662,
          "change_pct": -45.6540825285338
        },
        {
          "state": "QLD",
          "old": 555.0,
          "new": 253.0,
          "ratio_pct": 45.585585585585584,
          "change_pct": -54.414414414414416
        },
        {
          "state": "SA",
          "old": 275.0,
          "new": 166.0,
          "ratio_pct": 60.36363636363637,
          "change_pct": -39.63636363636363
        },
        {
          "state": "WA",
          "old": 162.0,
          "new": 99.0,
          "ratio_pct": 61.111111111111114,
          "change_pct": -38.888888888888886
        },
        {
          "state": "TAS",
          "old": 444.0,
          "new": 335.0,
          "ratio_pct": 75.45045045045045,
          "change_pct": -24.549549549549553
        }
      ],
      "transform": [
        {
          "type": "formula",
          "expr": "indexed ? 100 : datum.old",
          "as": "x0"
        },
        {
          "type": "formula",
          "expr": "indexed ? datum.ratio_pct : datum.new",
          "as": "x1"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {
        "signal": "indexed ? [0,100] : [0,5000]"
      },
      "range": [
        45,
        {
          "signal": "width-66"
        }
      ],
      "zero": true
    },
    {
      "name": "y",
      "type": "band",
      "domain": {
        "signal": "indexed ? ['QLD', 'VIC', 'NSW', 'SA', 'WA', 'TAS'] : ['VIC', 'NSW', 'QLD', 'TAS', 'SA', 'WA']"
      },
      "range": [
        40,
        {
          "signal": "height-100"
        }
      ],
      "paddingInner": 0.45,
      "paddingOuter": 0.25
    }
  ],
  "axes": [
    {
      "orient": "bottom",
      "scale": "x",
      "offset": -64,
      "values": {
        "signal": "indexed ? (width < 500 ? [0,50,100] : [0,25,50,75,100]) : (width < 500 ? [0,2500,5000] : [0,1000,2000,3000,4000,5000])"
      },
      "title": {
        "signal": "indexed ? 'Farm-count index · 2011–12 = 100' : 'Registered farms'"
      },
      "titleFontSize": 12,
      "titlePadding": 12,
      "titleFontWeight": "normal",
      "labelFontSize": 12,
      "format": ",.0f"
    }
  ],
  "marks": [
    {
      "type": "symbol",
      "encode": {
        "update": {
          "x": {
            "value": 5
          },
          "y": {
            "value": 12
          },
          "size": {
            "value": 55
          },
          "fill": {
            "value": "#7892a7"
          }
        }
      }
    },
    {
      "type": "symbol",
      "encode": {
        "update": {
          "x": {
            "value": 120
          },
          "y": {
            "value": 12
          },
          "size": {
            "value": 55
          },
          "fill": {
            "value": "#367d60"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 15
          },
          "y": {
            "value": 16
          },
          "text": {
            "value": "2011–12"
          },
          "fontSize": {
            "value": 12
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 130
          },
          "y": {
            "value": 16
          },
          "text": {
            "value": "2024–25 (p)"
          },
          "fontSize": {
            "value": 12
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width-3"
          },
          "y": {
            "value": 16
          },
          "text": {
            "value": "Change"
          },
          "fontSize": {
            "value": 12
          },
          "align": {
            "value": "right"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "pairs"
      },
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "scale": "y",
            "field": "state",
            "band": 0.5
          },
          "text": {
            "field": "state"
          },
          "fontWeight": {
            "value": "bold"
          },
          "fontSize": {
            "value": 12
          },
          "baseline": {
            "value": "middle"
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "pairs"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "x",
            "field": "x0"
          },
          "x2": {
            "scale": "x",
            "field": "x1"
          },
          "y": {
            "scale": "y",
            "field": "state",
            "band": 0.5
          },
          "stroke": {
            "value": "#c6d7e1"
          },
          "strokeWidth": {
            "value": 3
          },
          "tooltip": {
            "signal": "{'State':datum.state,'2011–12 farms':format(datum.old,',.0f'),'2024–25 farms (p)':format(datum.new,',.0f'),'Count relative to 2011–12 (%)':format(datum.ratio_pct,'.1f'),'Change (%)':format(datum.change_pct,'+.1f')}"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
