  "params": [
    {
      "name": "region",
      "value": "AUS",
      "bind": {
        "input": "select",
        "options": [
          "AUS",
          "NSW",
          "VIC",
          "QLD",
          "SA",
          "WA",
          "TAS"
        ],
        "name": "Region ",
        "labels": [
          "Australia",
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania"
        ]
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.state_code == region"
    }
  ],
  "encoding": {
    "x": {
      "field": "year_end",
      "type": "ordinal",
      "title": "Financial year ending June",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12
      }
    },
    "y": {
      "field": "production_bl",
      "type": "quantitative",
      "title": "Billion litres · focused scale",
      "scale": {
        "zero": false,
        "nice": true
      },
      "axis": {
        "tickCount": 5
      }
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "fy",
        "type": "nominal",
        "title": "Financial year"
      },
      {
        "field": "production_ml",
        "type": "quantitative",
        "title": "Milk (million litres)",
        "format": ",.1f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#286a9e",
        "strokeWidth": 3,
        "point": {
          "filled": true,
          "size": 65
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -13,
        "color": "#173d65",
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "display_bl",
          "type": "nominal"
        }
      },
      "transform": [
